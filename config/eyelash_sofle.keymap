#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

// This keymap follows TailorKey v4.2m for the MoErgo Go60 (Windows/Linux).
// The Go60's main keys match the Sofle's one-to-one. Its three-key bottom row
// per side sits on the Sofle's three straight thumb-row keys, and its first
// two thumb keys on the angled ones (the Go60's third thumb keys are dropped).
// Unlike TailorKey, holding Space opens Mouse and holding Enter opens Symbol.

// Key positions for the home row mods' "other hand" rule, as in TailorKey:
// each hand's main keys plus its bottom row. The angled thumb keys, the
// encoder press (52) and the centre 5-way switch (6 19 32 45 58, wired to the
// right half) count for both hands.
#define KEYS_LEFT   0  1  2  3  4  5 13 14 15 16 17 18 26 27 28 29 30 31 39 40 41 42 43 44 53 54 55
#define KEYS_RIGHT  7  8  9 10 11 12 20 21 22 23 24 25 33 34 35 36 37 38 46 47 48 49 50 51 61 62 63
#define KEYS_THUMBS 56 57 59 60 52  6 19 32 45 58

// Layer numbers. TailorKey's Keypad and Magic layers aren't ported yet, so
// for now they open the Sofle's original layers: Func (layer 1) and System
// (layer 2).
#define BASE       0
#define LAYER1     1
#define LAYER2     2
#define SYMBOL     3
#define CURSOR     4
#define MOUSE      5
#define MOUSE_SLOW 6
#define MOUSE_FAST 7
#define MOUSE_WARP 8
#define KEYPAD     LAYER1
#define MAGIC      LAYER2

// Pointer speed. Outside the Mouse layer (the 5-way switch on the Func and
// System layers) it moves at the MOVE_VAL above with no extra multiplier;
// raise the first number (e.g. 2 1) to speed it up. In the Mouse layer it runs
// at ZMK's standard speed, which TailorKey is built on, and the Mouse layer's
// speed keys give TailorKey's Slow (1/9), Fast (3x) and Warp (12x). The first
// rule whose layer is active wins, so the speed layers come first.
&mmv_input_listener {
    input-processors = <&zip_xy_scaler 1 1>;

    mouse_slow { layers = <MOUSE_SLOW>; input-processors = <&zip_xy_scaler 1 18>; };
    mouse_fast { layers = <MOUSE_FAST>; input-processors = <&zip_xy_scaler 3 2>; };
    mouse_warp { layers = <MOUSE_WARP>; input-processors = <&zip_xy_scaler 6 1>; };
    mouse      { layers = <MOUSE>;      input-processors = <&zip_xy_scaler 1 2>; };
};

// Scrolling keeps the Sofle's speed everywhere, so the encoder feels the
// same, and the speed keys scale it like TailorKey's: Slow 1/9, Fast 3x,
// Warp 12x (process-next then applies the usual 2x).
&msc_input_listener {
    input-processors = <&zip_scroll_scaler 2 1>;

    mouse_slow { layers = <MOUSE_SLOW>; input-processors = <&zip_scroll_scaler 1 9>;  process-next; };
    mouse_fast { layers = <MOUSE_FAST>; input-processors = <&zip_scroll_scaler 3 1>;  process-next; };
    mouse_warp { layers = <MOUSE_WARP>; input-processors = <&zip_scroll_scaler 12 1>; process-next; };
};

/ {

    behaviors {
        // TailorKey's home row mods. Each finger has its own timing. A mod
        // only activates when the next key is on the other hand or a thumb
        // key, so same-hand rolls stay letters.
        hrm_l_pinky: hrm_l_pinky {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Left Pinky";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hrm_l_ring: hrm_l_ring {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Left Ring";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hrm_l_middle: hrm_l_middle {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Left Middle";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <210>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hrm_l_index: hrm_l_index {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Left Index";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <190>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hrm_r_index: hrm_r_index {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Right Index";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <190>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <100>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hrm_r_middle: hrm_r_middle {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Right Middle";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <210>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hrm_r_ring: hrm_r_ring {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Right Ring";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <240>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        hrm_r_pinky: hrm_r_pinky {
            compatible = "zmk,behavior-hold-tap";
            display-name = "HRM Right Pinky";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            quick-tap-ms = <300>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMBS>;
            bindings = <&kp>, <&kp>;
        };

        // TailorKey's thumb keys: tap for the key, hold for a layer.
        thumb_lt: thumb_lt {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Thumb Layer-Tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <300>;
            bindings = <&mo>, <&kp>;
        };

        space_lt: space_lt {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Space Layer-Tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // TailorKey's Cursor layer macro.
        cur_select_line: cur_select_line {
            compatible = "zmk,behavior-macro";
            display-name = "Select Line";
            #binding-cells = <0>;
            wait-ms = <1>;
            tap-ms = <1>;
            bindings = <&kp HOME &kp LS(END)>;
        };

        // Holds the given modifier and taps Tab. The modifier stays held
        // until the key is released, so the app/tab switcher stays open.
        mod_tab: mod_tab {
            compatible = "zmk,behavior-macro-one-param";
            display-name = "Mod-Tab Switcher";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                ;
        };

        // Mod-tab switcher for the combos: also holds a layer (Cursor) while
        // the chord is held, so its arrows can pick the window or tab.
        mod_tab_chord: mod_tab_chord {
            compatible = "zmk,behavior-macro-two-param";
            display-name = "Mod-Tab Chord";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_2to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_param_1to1>
                , <&macro_press &mod_tab MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &mod_tab MACRO_PLACEHOLDER>
                , <&macro_param_2to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                ;
        };

        // Types "..".
        symb_dotdot: symb_dotdot {
            compatible = "zmk,behavior-macro";
            display-name = "Dot Dot";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp DOT &kp DOT>;
        };
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // TailorKey's combos: press the keys at the same time.
    combos {
        compatible = "zmk,combos";

        // F1-F12: a number-row key plus the key below it (F12 is 0 + -).
        combo_f1  { key-positions = <1 14>;  bindings = <&kp F1>;  layers = <BASE>; };
        combo_f2  { key-positions = <2 15>;  bindings = <&kp F2>;  layers = <BASE>; };
        combo_f3  { key-positions = <3 16>;  bindings = <&kp F3>;  layers = <BASE>; };
        combo_f4  { key-positions = <4 17>;  bindings = <&kp F4>;  layers = <BASE>; };
        combo_f5  { key-positions = <5 18>;  bindings = <&kp F5>;  layers = <BASE>; };
        combo_f6  { key-positions = <7 20>;  bindings = <&kp F6>;  layers = <BASE>; };
        combo_f7  { key-positions = <8 21>;  bindings = <&kp F7>;  layers = <BASE>; };
        combo_f8  { key-positions = <9 22>;  bindings = <&kp F8>;  layers = <BASE>; };
        combo_f9  { key-positions = <10 23>; bindings = <&kp F9>;  layers = <BASE>; };
        combo_f10 { key-positions = <11 24>; bindings = <&kp F10>; layers = <BASE>; };
        combo_f11 { key-positions = <12 25>; bindings = <&kp F11>; layers = <BASE>; };
        combo_f12 { key-positions = <11 12>; bindings = <&kp F12>; layers = <BASE>; };

        // Caps Lock: the Backspace and Space thumb keys.
        combo_caps_lock { key-positions = <56 60>; bindings = <&kp CAPS>; layers = <BASE>; };

        // Sticky Hyper (Ctrl+Alt+Shift+Win) and Meh (Ctrl+Alt+Shift).
        combo_hyper { key-positions = <47 61>; bindings = <&sk LG(LA(LC(LSHFT)))>; layers = <BASE>; };
        combo_meh   { key-positions = <48 62>; bindings = <&sk LA(LC(LSHFT))>;     layers = <BASE>; };

        // Alt/Ctrl/Win+Tab switchers: hold the chord, pick with the arrows.
        combo_alt_tab  { key-positions = <41 53>; bindings = <&mod_tab_chord LALT CURSOR>;  layers = <BASE>; };
        combo_ctrl_tab { key-positions = <43 55>; bindings = <&mod_tab_chord LCTRL CURSOR>; layers = <BASE>; };
        combo_win_tab  { key-positions = <44 56>; bindings = <&mod_tab_chord LGUI CURSOR>;  layers = <BASE>; };
    };

    keymap {
        compatible = "zmk,keymap";

        layer0 {
            bindings = <
&kp EQUAL               &kp N1                  &kp N2                  &kp N3                  &kp N4                  &kp N5                  &kp UP_ARROW            &kp N6                  &kp N7                  &kp N8                  &kp N9                  &kp N0                  &kp MINUS
&kp TAB                 &kp Q                   &kp W                   &kp E                   &kp R                   &kp T                   &kp DOWN_ARROW          &kp Y                   &kp U                   &kp I                   &kp O                   &kp P                   &kp BSLH
&kp ESC                 &hrm_l_pinky LGUI A     &hrm_l_ring LALT S      &hrm_l_middle LCTRL D   &hrm_l_index LSHFT F    &kp G                   &kp LEFT_ARROW          &kp H                   &hrm_r_index RSHFT J    &hrm_r_middle RCTRL K   &hrm_r_ring LALT L      &hrm_r_pinky LGUI SEMI  &kp SQT
&mo MAGIC               &kp Z                   &kp X                   &kp C                   &kp V                   &kp B                   &kp RIGHT_ARROW         &kp N                   &kp M                   &kp COMMA               &kp DOT                 &kp FSLH                &mo KEYPAD
&kp C_MUTE              &kp HOME                &kp LEFT                &kp RIGHT               &thumb_lt CURSOR BSPC   &thumb_lt KEYPAD DEL    &kp ENTER               &thumb_lt SYMBOL RET    &space_lt MOUSE SPACE    &kp UP                  &kp DOWN                &kp END
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Base";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &mmv MOVE_UP     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &trans
&trans      &kp GRAVE        &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4           &mmv MOVE_DOWN   &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&trans      &kp TILDE        &trans          &trans           &trans           &mkp MB5           &mmv MOVE_LEFT   &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &mmv MOVE_RIGHT  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "Func";
            sensor-bindings = <&scroll_encoder>;
        };

        layer_2 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &mmv MOVE_DOWN   &trans  &trans  &kp F11     &kp F12    &kp UNDER    &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &trans          &mmv MOVE_LEFT   &trans  &trans  &trans      &trans     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &trans          &mmv MOVE_RIGHT  &trans  &trans  &sys_reset  &soft_off  &bootloader  &trans
&trans     &trans        &trans          &trans        &trans        &trans          &mkp LCLK        &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "System";
            sensor-bindings = <&scroll_encoder>;
        };

        // TailorKey's Symbol layer (hold Enter). The '@' from the Go60's
        // third left thumb key sits on the empty right number row.
        symbol {
            bindings = <
&kp GRAVE     &kp COMMA     &kp LPAR      &kp RPAR      &kp SEMI      &kp DOT       &trans        &none         &kp AT        &none         &none         &none         &none
&kp EXCL      &kp LBKT      &kp LBRC      &kp RBRC      &kp RBKT      &kp QMARK     &trans        &kp GRAVE     &kp DEL       &kp LS(TAB)   &kp INS       &kp ESC       &none
&kp HASH      &kp CARET     &kp EQUAL     &kp UNDER     &kp DLLR      &kp STAR      &trans        &kp DQT       &kp BSPC      &kp TAB       &kp SPACE     &kp RET       &none
&kp TILDE     &kp LT        &kp PIPE      &kp MINUS     &kp GT        &kp FSLH      &trans        &kp SQT       &sk LSHFT     &sk LGUI      &sk LALT      &sk LCTRL     &none
&trans        &kp SQT       &kp DQT       &kp PLUS      &kp PRCNT     &kp COLON     &trans        &none         &none         &kp BSLH      &kp AMPS      &symb_dotdot
            >;

            display-name = "Symbol";
        };

        // TailorKey's Cursor layer (hold Backspace), with Select All in
        // place of Select Word.
        cursor {
            bindings = <
&none              &kp ESC            &kp INS            &kp LS(TAB)        &kp DEL            &none              &trans             &none              &none              &kp K_APP          &kp PAUSE_BREAK    &kp SLCK           &none
&kp CAPS           &kp RET            &kp LC(Y)          &kp LC(Z)          &kp BSPC           &kp LC(X)          &trans             &kp LC(X)          &kp LS(TAB)        &kp LC(Z)          &kp LC(Y)          &kp TAB            &kp PSCRN
&sk LSHFT          &kp LGUI           &kp LALT           &kp LCTRL          &kp LSHFT          &kp LC(C)          &trans             &kp LC(C)          &kp LEFT           &kp UP             &kp DOWN           &kp RIGHT          &sk RSHFT
&kp LC(L)          &kp LC(A)          &cur_select_line   &kp LC(A)          &kp LC(F)          &kp LC(V)          &trans             &kp LC(V)          &kp HOME           &kp PG_UP          &kp PG_DN          &kp END            &kp LC(L)
&trans             &none              &kp LC(LS(G))      &kp LC(G)          &none              &mod_tab LCTRL     &trans             &kp LS(END)        &kp LC(LS(RIGHT))  &kp LC(F)          &kp LC(LS(G))      &kp LC(G)
            >;

            display-name = "Cursor";
        };

        // TailorKey's Mouse layer (hold Space). The 5-way switch still moves and
        // clicks, the encoder scrolls, and pressing it is a middle click.
        // Unlike TailorKey, U/I/O are left/middle/right click instead of
        // sticky Shift/Ctrl/Alt.
        mouse {
            bindings = <
&none            &none            &none            &none            &none            &none            &mmv MOVE_UP     &none            &none            &none            &none            &none            &none
&none            &none            &msc SCRL_LEFT   &mmv MOVE_UP     &msc SCRL_RIGHT  &none            &mmv MOVE_DOWN   &none            &mkp LCLK        &mkp MCLK        &mkp RCLK        &sk RGUI         &none
&none            &msc SCRL_UP     &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &msc SCRL_UP     &mmv MOVE_LEFT   &msc SCRL_UP     &mo MOUSE_FAST   &mo MOUSE_WARP   &mo MOUSE_SLOW   &mkp LCLK        &mkp MB4
&none            &msc SCRL_DOWN   &mo MOUSE_SLOW   &mo MOUSE_WARP   &mo MOUSE_FAST   &msc SCRL_DOWN   &mmv MOVE_RIGHT  &msc SCRL_DOWN   &msc SCRL_LEFT   &mmv MOVE_UP     &msc SCRL_RIGHT  &mkp RCLK        &mkp MB5
&mkp MCLK        &kp LG(X)        &kp LG(C)        &kp LG(V)        &mkp LCLK        &mkp RCLK        &mkp LCLK        &mkp RCLK        &none            &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_RIGHT
            >;

            display-name = "Mouse";
            sensor-bindings = <&scroll_encoder>;
        };

        // Speed layers for the Mouse layer's speed keys (X/C/V and L/K/J). They
        // only change the pointer speed; see the input listeners at the top.
        mouse_slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Slow";
        };

        mouse_fast {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Fast";
        };

        mouse_warp {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Warp";
        };
    };
};
